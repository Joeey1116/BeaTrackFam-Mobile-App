name: Publish npm package

# Every published GitHub Release also ships the app project to GitHub
# Packages as a private npm package (@joeey1116/beatrackfam-mobile-app),
# versioned to match the app release. Uses the workflow's built-in
# GITHUB_TOKEN — no personal tokens stored anywhere.
# Can also be run by hand (Actions tab) with a tag input, e.g. v8.1.6,
# to publish a package for a release that already exists.

on:
  release:
    types: [published]
  workflow_dispatch:
    inputs:
      tag:
        description: "Existing release tag to publish as a package (e.g. v8.1.6)"
        required: true
        type: string

permissions:
  contents: read
  packages: write

jobs:
  publish:
    runs-on: ubuntu-latest
    steps:
      - name: Resolve tag and version
        id: ref
        run: |
          TAG="${{ inputs.tag || github.event.release.tag_name }}"
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"
          echo "version=${TAG#v}" >> "$GITHUB_OUTPUT"

      - name: Check out the tagged code
        uses: actions/checkout@v4
        with:
          ref: ${{ steps.ref.outputs.tag }}

      - name: Set up Node for GitHub Packages
        uses: actions/setup-node@v4
        with:
          node-version: "20"
          registry-url: "https://npm.pkg.github.com"
          scope: "@joeey1116"

      - name: Match package name and version to the release
        run: |
          npm pkg set name="@joeey1116/beatrackfam-mobile-app"
          npm pkg set version="${{ steps.ref.outputs.version }}"
          npm pkg delete private

      - name: Publish to GitHub Packages
        run: npm publish
        env:
          NODE_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
