{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.beatrackfaminc",
      "minSdkVersion": 24,
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "versionCode": 1200,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ],
      "edgeToEdgeEnabled": true
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.beatrackfaminc",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BeaTrackFam uses your location to personalize delivery options and show relevant availability.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1200"
    },
    "name": "BeaTrackFam",
    "orientation": "default",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This identifier is used to personalize your BeaTrackFam experience and measure app performance."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BeaTrackFam uses your location to personalize delivery options and show relevant availability."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.info.beatrackfam",
          "enableGooglePay": true
        }
      ]
    ],
    "scheme": [
      "beatrackfam",
      "shop.76755992730.auth"
    ],
    "slug": "beatrackfam",
    "userInterfaceStyle": "automatic",
    "version": "12.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb43fa7a-474d-4ed0-af1f-3593d7d1b7ea"
      }
    },
    "owner": "beatrackfam"
  }
}